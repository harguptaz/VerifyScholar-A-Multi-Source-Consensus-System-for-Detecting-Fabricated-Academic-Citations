# ---------------------------------------------------------------------------------------
# VerifyScholar configuration.
#   Docker:       cp .env.example .env            (in the project root)
#   Manual setup: cp .env.example backend/.env
# ---------------------------------------------------------------------------------------

# REQUIRED: a real contact address. CrossRef and OpenAlex use it to put you in their faster,
# more reliable "polite pool". It is only sent to them as a mailto parameter / User-Agent.
CONTACT_EMAIL=you@example.com

# RECOMMENDED: free OpenAlex API key (takes a minute): https://openalex.org/settings/api
OPENALEX_API_KEY=

# GROBID (reference extraction). With Docker Compose this is set for you (http://grobid:8070).
GROBID_URL=http://localhost:8070

# Where the app keeps jobs, cached API responses and the transparency log.
DATABASE_URL=sqlite:///./data/verifyscholar.db

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Relevance check similarity: auto | sentence-transformers | tfidf
#   auto = use sentence-transformers if installed, otherwise the simple TF-IDF fallback
EMBEDDING_BACKEND=auto

# ---- optional tuning (defaults shown) ---------------------------------------------------
# VERIFIED_THRESHOLD=80
# SUSPICIOUS_THRESHOLD=40
# MAX_CITATIONS_PER_JOB=200
# MAX_UPLOAD_MB=25
# USE_GROBID_FOR_CITATIONS=true     # false = always use the built-in parser for pasted citations
# USE_CSL_FORMATTING=true           # false = never call doi.org for reference formatting
# CACHE_TTL_HOURS=24
# HTTP_TIMEOUT_SECONDS=12           # per request to any data source
# HTTP_MAX_ATTEMPTS=3               # tries per request (timeouts, 429 and 5xx are retried)
# SOURCE_TIME_BUDGET_SECONDS=25     # a source that has not answered a citation in this time is reported "unavailable"
# SIDE_CHECK_BUDGET_SECONDS=10      # same for DOAJ, the retraction check and the fabrication heuristics
# NOT_INDEXED_MAX_YEAR_WORKS=25     # a real journal with at most this many CrossRef articles in the cited year is "thinly indexed":
#                                   # a missing paper is then "Inconclusive (not indexed)" instead of "Ghost". Lower = stricter.

# ---- secondary sources (free, no key). Asked only when CrossRef and OpenAlex leave a citation unsettled ----
# ENABLE_DBLP=true                  # computer-science conference and journal papers
# ENABLE_DATACITE=true              # arXiv, Zenodo, figshare and other DataCite DOIs; also lets the DOI-prefix check know DataCite prefixes
# ENABLE_OPENLIBRARY=true           # books
# SECONDARY_TIME_BUDGET_SECONDS=12  # DBLP / DataCite / Open Library, per citation; a source that is slower is reported "unavailable"
# DBLP_MAX_CONCURRENT_REQUESTS=2    # DBLP answers HTTP 429 to bursts, so keep this low