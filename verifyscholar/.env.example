# ---------------------------------------------------------------------------------------
# VerifyScholar configuration.
#   Docker:       cp .env.example .env            (in the project root)
#   Manual setup: cp .env.example backend/.env
# ---------------------------------------------------------------------------------------

# REQUIRED: a real contact address. CrossRef and OpenAlex use it to put you in their faster,
# more reliable "polite pool". It is only sent to them as a mailto parameter / User-Agent.
CONTACT_EMAIL=you@example.com

# RECOMMENDED: free OpenAlex API key (takes a minute): https://openalex.org/settings/api
OPENALEX_API_KEY=

# GROBID (reference extraction). With Docker Compose this is set for you (http://grobid:8070).
GROBID_URL=http://localhost:8070

# Where the app keeps jobs, cached API responses and the transparency log.
DATABASE_URL=sqlite:///./data/verifyscholar.db

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Relevance check similarity: auto | sentence-transformers | tfidf
#   auto = use sentence-transformers if installed, otherwise the simple TF-IDF fallback
EMBEDDING_BACKEND=auto

# ---- optional tuning (defaults shown) ---------------------------------------------------
# VERIFIED_THRESHOLD=80
# SUSPICIOUS_THRESHOLD=40
# MAX_CITATIONS_PER_JOB=200
# MAX_UPLOAD_MB=25
# USE_GROBID_FOR_CITATIONS=true     # false = always use the built-in parser for pasted citations
# USE_CSL_FORMATTING=true           # false = never call doi.org for reference formatting
# CACHE_TTL_HOURS=24
